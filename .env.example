# Copy to .env and fill in. Never commit .env.

# --- Gemini (Google AI Studio key) ---
GEMINI_API_KEY=your-key-from-google-ai-studio
GEMINI_MODEL=gemini-3.6-flash
# smart = Gemini only where rules are unsure or the file is not text (~150 calls for the full inbox)
# full  = Gemini on every email and every SI/BL (~770 calls)
GEMINI_MODE=smart
# review = OCR values from image-only files always go to a person; trust_ocr = compare them like text
SCANNED_POLICY=review
# name_only (compare company names) or full_block (name + address)
PARTY_COMPARE_MODE=name_only

# --- Storage ---
# local = JSON files in .localdb/ (offline dev). firestore = Firebase (needs the key below).
STORE=local
# base64 of the Firebase service-account JSON (Project settings > Service accounts > Generate key)
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Admin (used by scripts/ingest.py and scripts/submit.py; set the same value on Vercel) ---
ADMIN_TOKEN=change-me-to-a-long-random-string
API_BASE_URL=http://localhost:8000

# --- Dataset (organisers' participant bundle) ---
SHIPPEO_DATA_DIR=data
